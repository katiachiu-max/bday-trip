                    \{ time: "19:00", activity: "\uc0\u36215 \u39131 \u36820 \u28207 ", icon: "\u55356 \u56813 \u55356 \u56816 ", category: 'transport', cost: 0, desc: "\u26053 \u31243 \u22291 \u28415 \u32080 \u26463 ", address: "" \}\
                ]\
            \}\
        ];\
\
        // 2. STATE MANAGEMENT\
        const dayTabs = document.getElementById('day-tabs');\
        const itineraryContent = document.getElementById('itinerary-content');\
        const budgetSummary = document.getElementById('budget-summary');\
        const bookingDetails = document.getElementById('booking-details');\
        const homeScreen = document.getElementById('home-screen');\
        const toggleIcon = document.getElementById('toggle-icon');\
        let currentActiveDay = null;\
        let isBookingDetailsOpen = true;\
\
        // 3. CORE FUNCTIONS\
\
        function enterApp() \{\
            homeScreen.style.transform = 'translateY(-100%)';\
            setTimeout(() => \{ \
                homeScreen.style.display = 'none'; \
                updateStickyHeaderPosition(); // Recalculate sticky once hero is gone\
            \}, 600);\
        \}\
\
        // Logic to keep tabs sticky exactly below the header, even when header resizes\
        function updateStickyHeaderPosition() \{\
            const headerHeight = document.getElementById('main-header').offsetHeight;\
            dayTabs.style.top = `$\{headerHeight\}px`;\
        \}\
\
        function toggleBookingDetails() \{\
            isBookingDetailsOpen = !isBookingDetailsOpen;\
            if (isBookingDetailsOpen) \{\
                bookingDetails.classList.remove('collapsed-content');\
                toggleIcon.classList.remove('rotate-180');\
            \} else \{\
                bookingDetails.classList.add('collapsed-content');\
                toggleIcon.classList.add('rotate-180');\
            \}\
            \
            // Wait for transition to end then update sticky position\
            setTimeout(updateStickyHeaderPosition, 550);\
        \}\
\
        function updateBudget() \{\
            let total = 0;\
            itineraryData.forEach(d => d.events.forEach(e => \{\
                // \uc0\u20462 \u25913 \u65306 \u21482 \u35336 \u31639  1. \u20132 \u36890 \u36027  (transport) 2. \u24050 \u38928 \u35330 \u30340 \u26202 \u39184  (Ushigoro)\
                if (e.category === 'transport' || e.activity.includes('Ushigoro')) \{\
                    total += e.cost;\
                \}\
            \}));\
            \
            // \uc0\u35373 \u23450 \u32317 \u38928 \u31639 \u33287 \u21295 \u29575 \u20272 \u31639 \
            const budgetHKD = 12000;\
            const exchangeRate = 0.052; // \uc0\u38928 \u20272 \u21295 \u29575  (1 JPY \u8776  0.052 HKD)\
            const estimatedCostHKD = Math.round(total * exchangeRate);\
            const remainingHKD = budgetHKD - estimatedCostHKD;\
\
            document.getElementById('budget-summary').innerHTML = `\
                <div class="flex flex-col items-end">\
                    <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">\uc0\u32317 \u38928 \u31639  HK$$\{budgetHKD.toLocaleString()\}</span>\
                    <span class="text-sm font-bold $\{remainingHKD >= 0 ? 'text-emerald-600' : 'text-red-500'\}">\
                        \uc0\u39192 \u38989  HK$$\{remainingHKD.toLocaleString()\}\
                    </span>\
                    <span class="text-[9px] text-gray-400 mt-0.5">\
                        (\uc0\u22266 \u23450 \u25903 \u20986  \'a5$\{total.toLocaleString()\} \u8776  HK$$\{estimatedCostHKD.toLocaleString()\})\
                    </span>\
                </div>\
            `;\
        \}\
\
        function renderBookingInfo() \{\
            bookingDetails.innerHTML = `\
                <div class="bg-blue-50/80 p-4 rounded-xl border border-blue-100 mb-2">\
                    <div class="flex items-center text-blue-900 font-bold mb-2">\
                        <span class="text-xl mr-2">\uc0\u9992 \u65039 </span> \u27231 \u31080 \u36039 \u35338  <span class="ml-2 text-xs bg-blue-200 px-2 py-0.5 rounded text-blue-800">$\{BOOKING_INFO.pnr\}</span>\
                    </div>\
                    <div class="text-sm text-blue-800/80 space-y-1 pl-8">\
                        <p>\uc0\u55357 \u56421  $\{BOOKING_INFO.passengers.join(', ')\}</p>\
                        <p>\uc0\u55356 \u57234  $\{BOOKING_INFO.baggage.checked\}</p>\
                    </div>\
                </div>\
                <div class="bg-indigo-50/80 p-4 rounded-xl border border-indigo-100">\
                    <div class="flex items-center text-indigo-900 font-bold mb-2">\
                        <span class="text-xl mr-2">\uc0\u55356 \u57320 </span> \u20303 \u23487 \u36039 \u35338 \
                    </div>\
                    <div class="text-sm text-indigo-800/80 space-y-1 pl-8">\
                        <p class="font-medium">$\{BOOKING_INFO.hotel.name\}</p>\
                        <p class="text-xs opacity-75">$\{BOOKING_INFO.hotel.address\}</p>\
                        <div class="mt-2 flex gap-2">\
                            <span class="bg-red-100 text-red-700 text-xs px-2 py-1 rounded font-bold">\uc0\u26368 \u26202  $\{BOOKING_INFO.hotel.checkInLimit\}</span>\
                            <span class="bg-indigo-100 text-indigo-700 text-xs px-2 py-1 rounded font-bold">\'a5\uc0\u29694 \u22580 \u20184 \u36027 </span>\
                        </div>\
                    </div>\
                </div>\
            `;\
        \}\
\
        function renderTabs() \{\
            dayTabs.innerHTML = '';\
            itineraryData.forEach((day, idx) => \{\
                const btn = document.createElement('button');\
                btn.className = `flex-1 py-4 text-center text-sm font-medium transition-colors border-b-2 outline-none focus:outline-none $\{idx === 0 ? 'border-emerald-500 text-emerald-600 bg-emerald-50/50' : 'border-transparent text-gray-400 hover:text-gray-600'\}`;\
                btn.innerHTML = `<span class="block text-xs opacity-70">$\{day.date.split(' ')[0]\}</span><span class="block font-bold text-lg">$\{day.date.split('(')[1].replace(')','')\}</span>`;\
                btn.onclick = () => switchDay(idx);\
                dayTabs.appendChild(btn);\
            \});\
        \}\
\
        function getWeatherSvg(condition) \{\
            if(condition === 'sunny') return `<svg class="w-8 h-8 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>`;\
            if(condition === 'cloudy') return `<svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>`;\
            return `<svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>`;\
        \}\
\
        function switchDay(index) \{\
            if(currentActiveDay === index) return;\
            currentActiveDay = index;\
\
            // Update Tabs UI\
            Array.from(dayTabs.children).forEach((btn, idx) => \{\
                if(idx === index) \{\
                    btn.className = 'flex-1 py-4 text-center transition-all border-b-4 border-emerald-500 text-emerald-700 bg-emerald-50';\
                \} else \{\
                    btn.className = 'flex-1 py-4 text-center transition-all border-b-4 border-transparent text-gray-400 hover:bg-gray-50';\
                \}\
            \});\
\
            const day = itineraryData[index];\
            \
            // Render Timeline\
            let content = `\
                <div class="mb-6">\
                    <p class="text-gray-400 text-sm">$\{day.city\}</p>\
                </div>\
\
                <!-- Weather Card -->\
                <div class="ios-weather-card mb-8 flex items-center justify-between">\
                    <div>\
                        <div class="text-3xl font-light">$\{day.weather.temp\}</div>\
                        <div class="text-sm opacity-75 font-medium tracking-wide">$\{day.weather.summary\}</div>\
                    </div>\
                    <div>$\{getWeatherSvg(day.weather.condition)\}</div>\
                </div>\
\
                <!-- Timeline -->\
                <div class="relative pl-4 space-y-8 before:absolute before:left-[27px] before:top-2 before:bottom-4 before:w-[2px] before:bg-gray-100">\
            `;\
\
            day.events.forEach(ev => \{\
                const isWarning = ev.isWarning ? 'bg-red-50 border-red-200' : 'bg-white border-gray-100';\
                \
                // \uc0\u21028 \u26039 \u26159 \u21542 \u39023 \u31034 \u20729 \u26684 \u27161 \u31844 \
                const showCostBadge = ev.cost > 0 || ev.category === 'attraction' || ev.category === 'hotel';\
\
                content += `\
                    <div class="relative z-10">\
                        <!-- Icon Bubble -->\
                        <div class="absolute left-0 top-0 w-10 h-10 rounded-full bg-white border-4 border-gray-50 shadow-sm flex items-center justify-center text-lg z-20">\
                            $\{ev.icon\}\
                        </div>\
                        \
                        <!-- Content -->\
                        <div class="ml-14">\
                            <div class="$\{isWarning\} border p-4 rounded-xl shadow-sm hover:shadow-md transition-shadow">\
                                <h3 class="font-bold text-gray-800 text-lg mb-3">$\{ev.activity\}</h3>\
                                \
                                <ul class="space-y-2 text-sm text-gray-600">\
                                    <li class="flex items-start">\
                                        <span class="mr-2 text-lg">\uc0\u9200 </span>\
                                        <span class="mt-0.5 font-semibold $\{ev.isWarning ? 'text-red-600' : ''\}">$\{ev.time\}</span>\
                                    </li>\
                                    $\{ev.address ? `\
                                    <li class="flex items-start">\
                                        <span class="mr-2 text-lg">\uc0\u55357 \u56525 </span>\
                                        <span class="mt-0.5">$\{ev.address\}</span>\
                                    </li>\
                                    ` : ''\}\
                                    <li class="flex items-start">\
                                        <span class="mr-2 text-lg">\uc0\u55357 \u56541 </span>\
                                        <span class="mt-0.5">$\{ev.desc\}</span>\
                                    </li>\
                                </ul>\
                                \
                                <div class="flex justify-between items-center mt-4 pt-3 border-t border-dashed border-gray-100">\
                                    $\{showCostBadge ? `\
                                    <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded border border-emerald-100">\
                                        \uc0\u55357 \u56496  $\{ev.cost > 0 ? '\'a5' + ev.cost.toLocaleString() : 'Free'\}\
                                    </span>` : '<span></span>'\}\
                                    \
                                    $\{ev.address ? `\
                                        <a href="https://www.google.com/maps/search/?api=1&query=$\{encodeURIComponent(ev.address)\}" target="_blank" class="text-xs flex items-center text-blue-500 hover:text-blue-700 font-bold transition-colors bg-blue-50 px-3 py-1.5 rounded-full">\
                                            \uc0\u23566 \u33322  GO \u55357 \u56826 \u65039 \
                                        </a>\
                                    ` : ''\}\
                                </div>\
                            </div>\
                        </div>\
                    </div>\
                `;\
            \});\
\
            content += `</div>`; // End timeline\
\
            // Guide Section\
            content += `\
                <div class="mt-10 p-5 bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl border border-indigo-100/50">\
                    <div class="flex items-center mb-3">\
                        <span class="text-xl mr-2">\uc0\u55358 \u56598 </span>\
                        <h3 class="font-bold text-indigo-900">AI \uc0\u23566 \u36938 \u23567 \u36028 \u22763 </h3>\
                    </div>\
                    <div class="text-sm text-indigo-900/80 leading-relaxed space-y-2">\
                        $\{day.guide\}\
                    </div>\
                </div>\
            `;\
\
            itineraryContent.innerHTML = content;\
        \}\
\
        // 4. INITIALIZATION\
        window.onload = function() \{\
            updateBudget();\
            renderBookingInfo();\
            renderTabs();\
            switchDay(0);\
            updateStickyHeaderPosition(); // Initial calculation\
            \
            // Handle window resize for sticky header\
            window.addEventListener('resize', updateStickyHeaderPosition);\
        \};\
    </script>\
</body>\
</html>}